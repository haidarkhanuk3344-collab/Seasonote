<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
  <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
  <!-- WPF owns PerMonitorV2 via the manifest; WinForms is used only for NotifyIcon. -->
  <NoWarn>$(NoWarn);WFAC010</NoWarn><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><AssemblyName>Seasonote</AssemblyName>
  <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Seasonote.ico</ApplicationIcon>
  <Version>0.4.0</Version><Description>Seasonote seasonal desktop music ornament</Description>
 </PropertyGroup>
 <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" /></ItemGroup>
 <ItemGroup><None Include="Seasonote.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
 <ItemGroup><Compile Remove="obj/**;bin/**;dist/**" /></ItemGroup>
</Project>
